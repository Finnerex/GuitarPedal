 285:../../libDaisy/src/hid/disp/display.h ****                  uint_fast8_t radius,
 286:../../libDaisy/src/hid/disp/display.h ****                  int_fast16_t start_angle,
 287:../../libDaisy/src/hid/disp/display.h ****                  int_fast16_t sweep,
