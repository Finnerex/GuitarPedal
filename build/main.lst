 212:../../libDaisy/src/dev/oled_ssd130x.h ****     void SoftSpiTransmit(uint8_t val)
 213:../../libDaisy/src/dev/oled_ssd130x.h ****     {
 214:../../libDaisy/src/dev/oled_ssd130x.h ****         // bit flip
 215:../../libDaisy/src/dev/oled_ssd130x.h ****         val = ((val & 0x01) << 7) | ((val & 0x02) << 5) | ((val & 0x04) << 3)
