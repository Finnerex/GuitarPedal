 561:effect.cpp    **** // Phase vocoder implementation from https://www.guitarpitchshifter.com/algorithm.html
 562:effect.cpp    **** void PitchShifter::apply(const float* in, float* out, size_t samples) {
 563:effect.cpp    **** 
 564:effect.cpp    ****     if (!enabled.value) return;
 565:effect.cpp    **** 
 566:effect.cpp    ****     if (daisyMode.value) {
 567:effect.cpp    ****         for (size_t i = 0; i < samples; i++) {
 568:effect.cpp    ****             float s = in[i];
 569:effect.cpp    ****             out[i] = daisyPitchShifter.Process(s);
 570:effect.cpp    ****         }
 571:effect.cpp    **** 
 572:effect.cpp    ****         return;
 573:effect.cpp    ****     }
 574:effect.cpp    **** 
 575:effect.cpp    ****     for (size_t i = 0; i < samples; i++) {
 576:effect.cpp    ****         windowInputSamples.writeNext(in[i]);
 577:effect.cpp    ****     }
 578:effect.cpp    ****     
