 101:util.cpp      ****     for (int k = 0; k < N / 2; k++) {
 102:util.cpp      ****         std::complex<float> p = x[k];
 103:util.cpp      ****         std::complex<float> q = exp(2 * My_PI * 1if * (float)k / (float)N) * x[k + N / 2];
