  91:util.cpp      **** void iditfft2(std::complex<float>* X, int N, int s, float* x)
  92:util.cpp      **** {
  93:util.cpp      ****     if (N == 1) {
  94:util.cpp      ****         x[0] = X[0].real();
  95:util.cpp      ****         return;
  96:util.cpp      ****     }
  97:util.cpp      **** 
