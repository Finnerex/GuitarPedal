  73:../../libDaisy/src/util/PersistentStorage.h **** 
  74:../../libDaisy/src/util/PersistentStorage.h ****         // check to see if the state is already in use.
  75:../../libDaisy/src/util/PersistentStorage.h ****         State cur_state = storage_data->storage_state;
  76:../../libDaisy/src/util/PersistentStorage.h ****         if(cur_state != State::FACTORY && cur_state != State::USER)
  77:../../libDaisy/src/util/PersistentStorage.h ****         {
