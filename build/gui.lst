  24:../../libDaisy/src/util/PersistentStorage.h ****     /** State of the storage. 
  25:../../libDaisy/src/util/PersistentStorage.h ****      *  When created, prior to initialiation, the state will be Unknown
  26:../../libDaisy/src/util/PersistentStorage.h ****      *  
  27:../../libDaisy/src/util/PersistentStorage.h ****      *  During initialization, the state will be changed to either FACTORY,
  28:../../libDaisy/src/util/PersistentStorage.h ****      *  or USER. 
  29:../../libDaisy/src/util/PersistentStorage.h ****      * 
  30:../../libDaisy/src/util/PersistentStorage.h ****      *  If this is the first time these settings are being written to the
  31:../../libDaisy/src/util/PersistentStorage.h ****      *  target address, the defaults will be written to that location,
  32:../../libDaisy/src/util/PersistentStorage.h ****      *  and the state will be set to FACTORY.
  33:../../libDaisy/src/util/PersistentStorage.h ****      * 
  34:../../libDaisy/src/util/PersistentStorage.h ****      *  Once the first user-trigger save has been made, the state will be 
  35:../../libDaisy/src/util/PersistentStorage.h ****      *  updated to USER to indicate that the defaults have overwritten.
  36:../../libDaisy/src/util/PersistentStorage.h ****      */
  37:../../libDaisy/src/util/PersistentStorage.h ****     enum class State
  38:../../libDaisy/src/util/PersistentStorage.h ****     {
  39:../../libDaisy/src/util/PersistentStorage.h ****         UNKNOWN = 0,
  40:../../libDaisy/src/util/PersistentStorage.h ****         FACTORY = 1,
  41:../../libDaisy/src/util/PersistentStorage.h ****         USER    = 2,
  42:../../libDaisy/src/util/PersistentStorage.h ****     };
