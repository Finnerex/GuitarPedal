 179:../../libDaisy/src/dev/oled_ssd130x.h ****         clk_delay      = config.pin_config.sclk_delay;
 180:../../libDaisy/src/dev/oled_ssd130x.h ****         pin_mosi_.mode = DSY_GPIO_MODE_OUTPUT_PP;
 181:../../libDaisy/src/dev/oled_ssd130x.h ****         pin_mosi_.pin  = config.pin_config.mosi;
